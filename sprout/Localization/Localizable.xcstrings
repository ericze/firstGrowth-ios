    "account.conflict.current_email": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming account"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前尝试账号"
          }
        }
      }
    },
    "account.conflict.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To protect existing records, this device can only continue with the account that was linked earlier. Use the original account, or sign out and review before trying again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保护已有记录，这台设备只能继续使用之前绑定过的账号。请改用原账号登录，或先退出后再确认。"
          }
        }
      }
    },
    "account.conflict.linked_id": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked account ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已绑定账号 ID"
          }
        }
      }
    },
