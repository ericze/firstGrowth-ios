    "cloud_sync.account_required.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your records stay local until you choose an account. Sign in once, then backup can happen quietly in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你选择账号前，记录会继续保留在本地。登录一次后，后台备份才会安静地开始。"
          }
        }
      }
    },
    "cloud_sync.account_required.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in before syncing"
