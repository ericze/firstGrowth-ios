    "account.forgot_password.sent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account exists for this email, a password reset message has been sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果这个邮箱已注册，找回密码邮件已经发送。"
