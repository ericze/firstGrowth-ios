        }
      }
    },
    "account.form.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in quietly when you need backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要备份时，再安静地登录"
          }
        }
      }
    },
    "account.hero.conflict.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different account tried to sign in on a device that already has linked local records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有本地记录的设备上，刚刚尝试登录了另一个账号。"
          }
        }
      }
    },
    "account.hero.conflict.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account needs confirmation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号需要再次确认"
          }
        }
      }
    },
    "account.hero.loading.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We are checking whether this device already has a saved session."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统正在检查这台设备上是否已有保存过的会话。"
          }
        }
      }
    },
    "account.hero.loading.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring your session"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在恢复你的会话"
          }
        }
      }
    },
    "account.hero.signed_in.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is already linked. You can keep backup manual for now, or let automatic sync catch up later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备已经完成绑定。现在可以先手动备份，之后再承接自动同步。"
          }
        }
      }
    },
    "account.hero.signed_in.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account is connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号已连接"
          }
        }
      }
    },
    "account.hero.signed_out.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging in is optional. Keep daily recording local until backup becomes useful to you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录并不是必需步骤。你可以继续把日常记录留在本地，等真正需要备份时再连接账号。"
          }
        }
      }
    },
    "account.hero.signed_out.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use backup only when it helps"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在需要时，再启用备份"
          }
        }
      }
    },
